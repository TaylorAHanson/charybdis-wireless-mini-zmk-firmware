#include <zephyr/dt-bindings/input/input-event-codes.h>

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 31)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 31)>;
            low-power-enable;
        };
    };
};

/ {
    bitbang_spi: bitbang-spi {
        compatible = "zephyr,spi-bitbang";
        #address-cells = <1>;
        #size-cells = <0>;
        clk-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
        mosi-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
        miso-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
        cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
        status = "okay";

        trackball: trackball@0 {
            status = "okay";
            compatible = "pixart,pmw3610";
            reg = <0>;
            spi-max-frequency = <2000000>;
            spi-cpol;
            spi-cpha;
            duplex = <2048>; /* SPI_HALF_DUPLEX */
            motion-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,axis-x = <INPUT_REL_X>;
            zephyr,axis-y = <INPUT_REL_Y>;
        };
    };
};

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};
